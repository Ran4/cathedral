// Committed defaults. The game reads the git-ignored `config.ron` first and
// falls back to this file; in-game settings changes rewrite `config.ron`.
// Window settings. Set `fullscreen` to false to use a resizable window.
(
    title: "The Cathedral of Impossible Light",
    fullscreen: true,
    width: 1920,
    height: 1080,
    resizable: true,
    // One sim-owned summer weather schedule. Presentation quality never changes
    // the schedule, actor decisions, thunder timing, or authoritative wetness.
    weather: (
        enabled: true,
        // seed 7553 is clear for 02m40s then: Dp 09:20–16:25; Cl 27:30–30:40; St 33:10–42:45; Rn 46:33–51:08; Cl 57:30–60:00
        // assumption: Starts Day 2 at 07:00.
        // where Dp downpour, St storm, Rn rain, Dz drizzle, Fg fog, Cl clear
        seed: 7553,
        // timeline, clear, broken, overcast, fog, drizzle, rain, downpour, storm
        mode: "timeline",
        // Episode frequency, not intensity. 0.0 is a stable clear comparison.
        frequency: 1.0,
        // low, medium, high
        quality: "high",
        volumetric_fog: true,
    ),
    vermin: (
        enabled: true,
        seed: 40,
        // Scales the authored per-colony rat counts and nothing else.
        density: 1.0,
        // Whether a nightly boil may cross into the sim as an unattributed
        // world sound. The ordinary rats never reach the sim regardless.
        swarm_percepts: true,
    ),
    smart_actors: (
        enabled: true,
        fake_backend: false,
        uv_binary: "uv",
        // NPC voice audio: "local" (streaming Pocket TTS), "cloud" (OpenAI), or "off".
        tts_backend: "local",
        // Player transcription: "cloud" (OpenAI gpt-4o-transcribe) or "local"
        // (Canary-Qwen FP16).
        stt_backend: "local",
        // false enables full-duplex capture: NPC audio never pauses the microphone,
        // and microphone activity never interrupts NPC playback.
        pause_microphone_during_npc_voice: true,
        // Stream cloud transcription while you are still speaking; batch
        // transcription of the finished recording remains the fallback.
        stt_streaming: true,
        // Silence that ends an utterance, in milliseconds (clamped 300..=1500).
        stt_trailing_silence_ms: 400,
        // Non-speech sound percepts (F = fart; see features/sounds.md).
        sounds: (
            enabled: true,
            // Total FOV for the "saw who did it" test; 135 is a playtest guess.
            view_cone_degrees: 135.0,
            // Engine-side rate limit; sounds inside the cooldown drop silently.
            min_seconds_between_player_sounds: 2.0,
        ),
        // No LLM turn is spent on an actor you cannot see, hear or talk to
        // (features/implemented/gate_idle_cognition_on_proximity.md).
        idle_cognition: (
            // "stage" gives idle turns only to the people near you. "all"
            // restores the old city-wide rotation: ~1,100 provider calls an
            // hour, sustained, whether or not anybody is there to notice.
            mode: "stage",
            // Deliberately wider than the 20 m hearing radius, so an NPC has
            // been thinking for a while by the time you can hear them instead
            // of visibly booting when you walk up.
            radius_m: 32.0,
            // How many neighbours share the rotation. Still only one provider
            // request in flight at a time — this caps how thinly the turns are
            // spread, not how many run at once.
            max_actors: 6,
            require_news: true,
            curiosity: true,
            curiosity_scale: 1.0,
        ),
        // The authored street-dog pack (features/implemented/dogs.md): ten
        // named dogs wandering their own wards, listed on every nearby sheet
        // as dogs_nearby. Costs no tokens; CATHEDRAL_NO_DOGS=1 forces it off
        // for one run without editing this file.
        dogs_enabled: true,
        // Chalk on the walls (features/chalking_the_walls.md): a cross on a
        // debtor's door, a tally at a well, a ward-sign at a place of resort.
        // Written by code, read by code — zero tokens. CATHEDRAL_NO_MARKS=1
        // ablates the whole layer for one run without editing this file.
        marks: (
            enabled: true,
            // Per-kind switches, so one writer can be silenced without
            // losing the medium.
            cross: true,
            tally: true,
            ward_sign: true,
            // Multiplies elapsed time in the weathering. 1.0 is the authored
            // nine-day dry half-life; 200.0 washes a wall inside a drive run.
            decay_scale: 1.0,
        ),
        // The world clock (movement M0): the day/night cycle, the seven offices,
        // and the town bell. Pure — a projection of the engine's `now`.
        clock: (
            // Real seconds per game day. 3600 is one game day per real hour (24×).
            seconds_per_day: 3600.0,
            // Which office the run opens on; "dayspring" is a working morning.
            start_office: "dayspring",
            // Day 0 is a Bellday; 2 opens on a Highmarket.
            start_day: 2,
            // Night's brightness floor. 0.05 is genuinely dark.
            night_brightness: 0.05,
            // Ring the town bell for the player as each office comes round.
            ring_the_offices: true,
        ),
    ),
)
