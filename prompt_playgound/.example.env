# NPC text cognition (Moonshot or OpenAI).
LLM_PROVIDER=moonshot
LLM_MODEL=
MOONSHOT_API_KEY=
OPENAI_API_KEY=

# Player transcription and NPC voices use OpenAI independently of LLM_PROVIDER.
STT_MODEL=gpt-4o-transcribe
# Local Z-toggle backend. Canary-Qwen is English-only and runs in FP16 on CUDA.
LOCAL_STT_MODEL=nvidia/canary-qwen-2.5b
TTS_MODEL=tts-1
TTS_VOICE_SVEN=
TTS_VOICE_CONNY=
TTS_VOICE_ILSE=

NPC_TURN_DELAY_SECONDS=1.0
