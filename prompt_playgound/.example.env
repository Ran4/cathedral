# NPC text cognition (Moonshot or OpenAI).
LLM_PROVIDER=moonshot
LLM_MODEL=
MOONSHOT_API_KEY=
OPENAI_API_KEY=

# Player transcription and NPC voices use OpenAI independently of LLM_PROVIDER.
STT_MODEL=gpt-4o-transcribe
# Streaming transcription over the realtime API while you speak; the batch
# STT_MODEL above remains the per-utterance fallback.
STT_REALTIME_MODEL=gpt-realtime-whisper
STT_REALTIME_DELAY=low
# Optional language hint (e.g. en, sv); empty = provider auto-detect.
STT_LANGUAGE=
# How long a committed utterance may wait for its streamed transcript before
# the WAV is batch-transcribed instead, and how long an idle realtime socket
# stays warm.
STT_STREAM_COMPLETION_GRACE_MS=2000
STT_STREAM_IDLE_CLOSE_S=300
# Local Z-toggle backend. Canary-Qwen is English-only and runs in FP16 on CUDA.
LOCAL_STT_MODEL=nvidia/canary-qwen-2.5b
LOCAL_STT_PYTHON=3.12
LOCAL_STT_TORCH_INDEX=https://download.pytorch.org/whl/cu124
TTS_MODEL=tts-1
TTS_OPENAI_VOICE_SVEN=
TTS_OPENAI_VOICE_CONNY=
TTS_OPENAI_VOICE_ILSE=
# Local X-toggle backend. Pocket TTS streams PCM on CPU; uv installs and warms
# its isolated model/voice worker when the game starts.
LOCAL_TTS_PYTHON=3.12
# Optional: raises Hugging Face download rate limits. Keep the real token out
# of config.ron and source control.
HF_TOKEN=
TTS_POCKET_VOICE_SVEN=michael
TTS_POCKET_VOICE_CONNY=george
TTS_POCKET_VOICE_ILSE=alba

NPC_TURN_DELAY_SECONDS=1.0
