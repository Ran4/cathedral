// Window settings. Set `fullscreen` to false to use a resizable window.
(
    title: "The Cathedral of Impossible Light",
    fullscreen: true,
    width: 1920,
    height: 1080,
    resizable: true,
    smart_actors: (
        enabled: true,
        fake_backend: false,
        uv_binary: "uv",
        server_script: "prompt_playgound/server.py",
        // NPC voice audio: "local" (streaming Pocket TTS), "cloud" (OpenAI), or "off".
        tts_backend: "local",
        // false enables full-duplex capture: NPC audio never pauses the microphone,
        // and microphone activity never interrupts NPC playback.
        pause_microphone_during_npc_voice: true,
        // Stream cloud transcription while you are still speaking; batch
        // transcription of the finished recording remains the fallback.
        stt_streaming: true,
        // Silence that ends an utterance, in milliseconds (clamped 300..=1500).
        stt_trailing_silence_ms: 500,
    ),
)
